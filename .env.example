# Copy this file to .env.local and fill in the values for local development.
# Never commit .env.local (it is gitignored).

# --- Application ---
NEXT_PUBLIC_APP_NAME="Peduli Stunting"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase ---
# From Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Used by import scripts and admin paths (never exposed to client).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Sentry ---
# Public DSN; safe to expose to browser
NEXT_PUBLIC_SENTRY_DSN=""
# Server-only token for source map upload (CI/local only)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL="info"
