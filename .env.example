# Copy this file to .env.local and fill in the values for local development.
# Never commit .env.local (it is gitignored).

# --- Application ---
NEXT_PUBLIC_APP_NAME="Peduli Stunting"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase ---
# From Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Used by import scripts and admin paths (never exposed to client).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Sentry ---
# Public DSN; safe to expose to browser
NEXT_PUBLIC_SENTRY_DSN=""
# Server-only token for source map upload (CI/local only)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL="info"

# --- Gemini AI (server-only) ---
# Google Generative Language API key. The browser never sees this; only the
# `/api/ai/chat` Route Handler uses it. To move from the dev free tier to a paid
# (no-training) key, change this value only — no code change. See docs/adr/0020.
GEMINI_API_KEY=""
# Model id. Keep cheap for at-scale usage.
GEMINI_MODEL="gemini-2.5-flash-lite"
# Hard cap on output tokens per response (cost guard).
GEMINI_MAX_OUTPUT_TOKENS="1024"
# "true" acknowledges that on the FREE tier Google may train on the tracker
# payload (child growth data). Set "false" once you switch to a paid key. ADR-0021.
GEMINI_TRACKER_DATA_TRAINING_RISK_ACCEPTED="true"

# --- Upstash Redis (rate limiting; server-only) ---
# From the Upstash console (https://console.upstash.com) > your Redis DB > REST API.
# When left blank, rate limiting falls back to a permissive no-op (dev only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
